{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "right": 4
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[35m┌────────────────────────────Hardware────────────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "magenta",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "└ └󰋊",
      "keyColor": "magenta",
      "folders": "/home"
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m┌────────────────────────────Software────────────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "bios",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "└ └",
      "keyColor": "magenta",
      "text": "zsh --version | cut -d' ' -f1,2"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "95"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂",
      "keyColor": "95"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "95"
    },
    {
      "type": "terminal",
      "key": "└ └󰆍",
      "keyColor": "95"
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m┌──────────────────────────Uptime / Age──────────────────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": "       OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "       Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    }
  ]
}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "right": 4
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[35m┌────────────────────────────Hardware────────────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "magenta",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "└ └󰋊",
      "keyColor": "magenta",
      "folders": "/home"
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m┌────────────────────────────Software────────────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "bios",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "└ └",
      "keyColor": "magenta",
      "text": "zsh --version | cut -d' ' -f1,2"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "95"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂",
      "keyColor": "95"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼",
      "keyColor": "95"
    },
    {
      "type": "terminal",
      "key": "└ └󰆍",
      "keyColor": "95"
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m┌──────────────────────────Uptime / Age──────────────────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "text": "a=\"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\"; s=$(cut -d. -f1 /proc/uptime); u=\"\"; f() { [ $1 -gt 0 ] && u=\"$u$1 $2$([ $1 -ne 1 ] && echo s), \"; }; f $((s/86400)) day; f $((s%86400/3600)) hour; f $((s%3600/60)) min; u=\"${u%, }\"; [ -z \"$u\" ] && u=\"0 mins\"; w=$(( ${#a} > ${#u} ? ${#a} : ${#u} )); p=$(( (66 - 8 - w) / 2 )); printf '%*s\\033[35mOS Age\\033[0m: %s\\n' $p '' \"$a\""
    },
    {
      "type": "command",
      "key": " ",
      "text": "a=\"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\"; s=$(cut -d. -f1 /proc/uptime); u=\"\"; f() { [ $1 -gt 0 ] && u=\"$u$1 $2$([ $1 -ne 1 ] && echo s), \"; }; f $((s/86400)) day; f $((s%86400/3600)) hour; f $((s%3600/60)) min; u=\"${u%, }\"; [ -z \"$u\" ] && u=\"0 mins\"; w=$(( ${#a} > ${#u} ? ${#a} : ${#u} )); p=$(( (66 - 8 - w) / 2 )); printf '%*s\\033[35mUptime\\033[0m: %s\\n' $p '' \"$u\""
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    }
  ]
}

#!/usr/bin/env python3
import hashlib, http.server, json, mimetypes, os, shutil, tomllib

SETTINGS_FILE = os.path.expanduser("~/.local/state/noctalia/settings.toml")
LIVE_FILE = os.path.expanduser("~/.local/state/noctalia/mpvpaper/assignments.json")


def current_wallpaper():
    with open(SETTINGS_FILE, "rb") as f:
        data = tomllib.load(f).get("wallpaper", {})
    for entry in list(data.get("monitors", {}).values()) + [data.get("last", {}), data.get("default", {})]:
        if isinstance(entry, dict) and entry.get("path"):
            return entry["path"]
    raise OSError("no wallpaper set")


def live_wallpaper():
    try:
        with open(LIVE_FILE) as f:
            assignments = json.load(f).get("assignments", {})
    except (OSError, ValueError):
        return None
    for path in assignments.values():
        if os.path.isfile(path):
            return path
    return None


class Handler(http.server.BaseHTTPRequestHandler):
    def send_text(self, text):
        data = text.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        try:
            route = self.path.split("?")[0]
            if route == "/live-id":
                live = live_wallpaper()
                return self.send_text(hashlib.sha1(live.encode()).hexdigest() if live else "")
            path = live_wallpaper() if route == "/live" else current_wallpaper()
            if not path:
                return self.send_error(404)
            size = os.path.getsize(path)
            with open(path, "rb") as f:
                self.send_response(200)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "image/jpeg")
                self.send_header("Content-Length", str(size))
                self.send_header("Cache-Control", "no-store")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()
                shutil.copyfileobj(f, self.wfile)
        except (OSError, ValueError):
            self.send_error(404)

    def log_message(self, *args):
        pass


http.server.ThreadingHTTPServer(("127.0.0.1", 1928), Handler).serve_forever()

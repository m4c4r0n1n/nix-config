#!/usr/bin/env python3
"""Fastfetch beside a tumbling 3D NixOS flake, colored from the wallpaper palette.

zsh hooks pause it while a command runs and resume it at the next prompt. It ends
once output scrolls it off screen, because its position is then gone.
"""
import os, re, select, shutil, signal, subprocess, sys, termios, time, tty

HOME = os.path.expanduser("~")
FRAMES = HOME + "/.config/fastfetch/nix-spin.bin"
PALETTE = HOME + "/.config/ghostty/themes/noctalia-extra"
LOGO_COLUMNS = 46
FPS = 60
RAMP = " .:-=+*#%@"


def palette():
    found = {}
    try:
        with open(PALETTE) as f:
            for slot, value in re.findall(r"palette = (\d+)=#([0-9a-fA-F]{6})", f.read()):
                found[int(slot)] = tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))
    except OSError:
        pass
    return found.get(1, (126, 186, 228)), found.get(2, (82, 119, 195))


def shades(base):
    return [None] + [tuple(int(c * (0.3 + 0.7 * s / 15)) for c in base) for s in range(1, 16)]


class Flake:
    def __init__(self):
        with open(FRAMES, "rb") as f:
            raw = f.read()
        self.count = raw[0] + raw[3] * 256
        self.width, self.height = raw[1], raw[2]
        self.data = raw[4:]
        self.rows = self.height // 2
        self.colors()

    def colors(self):
        first, second = palette()
        self.table = [None] * 32
        for tone, base in enumerate((first, second)):
            for shade, rgb in enumerate(shades(base)):
                self.table[tone * 16 + shade] = rgb
        self.cache = {}

    def lines(self, index):
        if index in self.cache:
            return self.cache[index]
        at = index * self.width * self.height
        width, data, table = self.width, self.data, self.table
        result = []
        for row in range(self.rows):
            cells = []
            for x in range(width):
                value = max(data[at + row * 2 * width + x], data[at + (row * 2 + 1) * width + x])
                rgb = table[value]
                if rgb:
                    shade = value & 15
                    cells.append("\x1b[38;2;%d;%d;%dm%s" % (rgb + (RAMP[1 + shade * 8 // 15],)))
                else:
                    cells.append(" ")
            result.append("".join(cells) + "\x1b[0m")
        self.cache[index] = result
        return result


def cursor_row():
    """Asks the terminal which row the cursor is on."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd, termios.TCSANOW)
        os.write(1, b"\x1b[6n")
        reply = b""
        end = time.time() + 0.3
        while time.time() < end and not reply.endswith(b"R"):
            if select.select([fd], [], [], 0.05)[0]:
                reply += os.read(fd, 32)
        found = re.search(rb"\[(\d+);\d+R", reply)
        return int(found.group(1)) if found else None
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, saved)


def spin(flake, top, shell, pidfile):
    """Runs detached, drawing each frame at a fixed spot on the screen."""
    size = shutil.get_terminal_size()
    state = {"paused": False}

    def frame(index):
        body = "".join("\x1b[%d;1H%s" % (top + row, line) for row, line in enumerate(flake.lines(index)))
        return ("\x1b[?2026h\x1b7" + body + "\x1b8\x1b[?2026l").encode()

    def stop(*_):
        try:
            os.remove(pidfile)
        except OSError:
            pass
        os._exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGWINCH, stop)
    signal.signal(signal.SIGUSR1, lambda *_: state.update(paused=True))
    signal.signal(signal.SIGUSR2, lambda *_: state.update(paused=False))
    stamp = os.path.getmtime(PALETTE)
    index = 0
    while True:
        try:
            os.kill(shell, 0)
            if not state["paused"]:
                os.write(1, frame(index))
                index = (index + 1) % flake.count
            if os.path.getmtime(PALETTE) != stamp:
                stamp = os.path.getmtime(PALETTE)
                flake.colors()
        except OSError:
            stop()
        if shutil.get_terminal_size() != size:
            stop()
        time.sleep(1 / FPS)


def resume():
    """Runs at each prompt: carry on if the flake is still where it was."""
    pidfile = "%s/nix-spin-%d" % (os.environ.get("XDG_RUNTIME_DIR", "/tmp"), os.getppid())
    try:
        with open(pidfile) as f:
            pid, top, rows = (int(v) for v in f.read().split())
        row = cursor_row()
        lines = shutil.get_terminal_size().lines
        gone = row is None or row >= lines - 1 or row < top + rows
        os.kill(pid, signal.SIGTERM if gone else signal.SIGUSR2)
    except (OSError, ValueError):
        pass


def main():
    info = subprocess.run(["fastfetch", "--pipe", "false", "--logo", "none"],
                          capture_output=True, text=True).stdout.rstrip("\n").split("\n")
    try:
        flake = Flake()
    except OSError:
        print("\n".join(info))
        return
    tall = max(flake.rows, len(info)) + 1
    first = flake.lines(0)
    out = "\n" * (tall + 3) + "\x1b[%dA" % (tall + 3)
    out += "".join("\x1b[%dG%s\n" % (LOGO_COLUMNS + 3, line) for line in info)
    out += "\x1b[%dA" % len(info)
    out += "".join("\x1b[1G%s\n" % line for line in first)
    out += "\x1b[%dB\x1b[1G" % max(0, tall - flake.rows - 1)
    sys.stdout.write(out)
    sys.stdout.flush()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return
    row = cursor_row()
    if row is None:
        return
    top = row - (tall - 1)
    shell = os.getppid()
    pidfile = "%s/nix-spin-%d" % (os.environ.get("XDG_RUNTIME_DIR", "/tmp"), shell)
    if os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    with open(pidfile, "w") as f:
        f.write("%d %d %d" % (os.getpid(), top, flake.rows))
    spin(flake, top, shell, pidfile)


resume() if sys.argv[1:] == ["--resume"] else main()

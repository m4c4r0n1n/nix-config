+    fn kittyDnd(self: *StreamHandler, v: terminal.osc.Command.KittyDndProtocol) !void {
+        const dnd = terminal.kitty.dnd;
+        const meta = dnd.Metadata.parse(v.metadata) orelse return;
+        const t = meta.type orelse return;
+        const payload = v.payload orelse "";
+        switch (t) {
+            .offer => switch (meta.cell_x) {
+                1 => self.surfaceMessageWriter(.{ .kitty_drag_enable = true }),
+                2 => self.surfaceMessageWriter(.{ .kitty_drag_enable = false }),
+                0 => {
+                    self.kitty_drag_uri.clearRetainingCapacity();
+                    self.kitty_drag_text.clearRetainingCapacity();
+                    self.kitty_drag_uri_idx = -1;
+                    self.kitty_drag_text_idx = -1;
+                    var it = std.mem.tokenizeScalar(u8, payload, ' ');
+                    var i: i32 = 0;
+                    while (it.next()) |mime| : (i += 1) {
+                        if (std.mem.eql(u8, mime, "text/uri-list")) self.kitty_drag_uri_idx = i;
+                        if (std.mem.eql(u8, mime, "text/plain")) self.kitty_drag_text_idx = i;
+                    }
+                },
+                else => {},
+            },
+
+            .present => {
+                if (meta.cell_x < 0 or payload.len == 0) return;
+                const list = if (meta.cell_x == self.kitty_drag_uri_idx)
+                    &self.kitty_drag_uri
+                else if (meta.cell_x == self.kitty_drag_text_idx)
+                    &self.kitty_drag_text
+                else
+                    return;
+                const decoder = std.base64.standard_no_pad.Decoder;
+                const size = decoder.calcSizeForSlice(payload) catch return;
+                const dest = try list.addManyAsSlice(self.alloc, size);
+                decoder.decode(dest, payload) catch {
+                    list.shrinkRetainingCapacity(list.items.len - size);
+                };
+            },
+
+            .start_drag => {
+                if (meta.cell_x != -1 or self.kitty_drag_uri.items.len == 0) return;
+                var data: std.ArrayListUnmanaged(u8) = .empty;
+                defer data.deinit(self.alloc);
+                try data.appendSlice(self.alloc, self.kitty_drag_uri.items);
+                try data.append(self.alloc, 0);
+                try data.appendSlice(self.alloc, self.kitty_drag_text.items);
+                self.surfaceMessageWriter(.{
+                    .kitty_drag_start = try apprt.surface.Message.WriteReq.init(self.alloc, data.items),
+                });
+                const reply: []const u8 = "\x1b]72;t=E;OK\x1b\\";
+                self.messageWriter(try termio.Message.writeReq(self.alloc, reply));
+            },
+
+            .drag_error => {
+                self.kitty_drag_uri.clearRetainingCapacity();
+                self.kitty_drag_text.clearRetainingCapacity();
+            },
+
+            else => {},
+        }
+    }

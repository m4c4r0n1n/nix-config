diff --git a/src/apprt/gtk/class/surface.zig b/src/apprt/gtk/class/surface.zig
index 92cd597..b036da9 100644
--- a/src/apprt/gtk/class/surface.zig
+++ b/src/apprt/gtk/class/surface.zig
@@ -3752,6 +3752,41 @@ pub const Surface = extern struct {
         return @intFromBool(shown);
     }
 
+    pub fn startDrag(self: *Self, data: []const u8) void {
+        const widget = self.as(gtk.Widget);
+        const native = widget.getNative() orelse return;
+        const surface = native.as(gtk.Native).getSurface() orelse return;
+        const seat = widget.getDisplay().getDefaultSeat() orelse return;
+        const device = seat.getPointer() orelse return;
+
+        const split = std.mem.indexOfScalar(u8, data, 0) orelse data.len;
+        const uris = data[0..split];
+        const text = if (split < data.len) data[split + 1..] else "";
+
+        const uri_bytes = glib.Bytes.new(uris.ptr, uris.len);
+        defer uri_bytes.unref();
+        const text_bytes = glib.Bytes.new(text.ptr, text.len);
+        defer text_bytes.unref();
+        var providers = [_]*gdk.ContentProvider{
+            gdk.ContentProvider.newForBytes("text/uri-list", uri_bytes),
+            gdk.ContentProvider.newForBytes("text/plain;charset=utf-8", text_bytes),
+        };
+        const provider = gdk.ContentProvider.newUnion(&providers, providers.len);
+        defer provider.unref();
+
+        const drag = gdk.Drag.begin(surface, device, provider, .{ .copy = true }, 0, 0) orelse return;
+        _ = gdk.Drag.signals.dnd_finished.connect(drag, *Self, kittyDragFinished, self, .{});
+        _ = gdk.Drag.signals.cancel.connect(drag, *Self, kittyDragCancelled, self, .{});
+    }
+
+    fn kittyDragFinished(_: *gdk.Drag, self: *Self) callconv(.c) void {
+        if (self.core()) |core_surface| core_surface.kittyDragFinished();
+    }
+
+    fn kittyDragCancelled(_: *gdk.Drag, _: gdk.DragCancelReason, self: *Self) callconv(.c) void {
+        if (self.core()) |core_surface| core_surface.kittyDragFinished();
+    }

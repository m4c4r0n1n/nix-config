 namespace {
 struct RGB { int r, g, b; };
 
+// Gradients are computed here, so they must use the terminal's real colours.
+// Ghostty's wallpaper palette is re-read whenever the file changes.
+bool ghostty_palette_rgb(int idx, RGB& out) {
+    static std::mutex lock;
+    static RGB colours[256];
+    static bool known[256] = {};
+    static time_t checked = 0, stamp = 0;
+    std::lock_guard<std::mutex> guard(lock);
+    const time_t now = time(nullptr);
+    if (now != checked) {
+        checked = now;
+        const char* home = getenv("HOME");
+        const std::string path = std::string(home ? home : "") +
+                                 "/.config/ghostty/themes/noctalia-extra";
+        struct stat info;
+        if (stat(path.c_str(), &info) == 0 && info.st_mtime != stamp) {
+            stamp = info.st_mtime;
+            std::ifstream in(path);
+            std::string line;
+            while (std::getline(in, line)) {
+                int slot, r, g, b;
+                if (sscanf(line.c_str(), "palette = %d=#%2x%2x%2x", &slot, &r, &g, &b) == 4 &&
+                    slot >= 0 && slot < 256) {
+                    colours[slot] = {r, g, b};
+                    known[slot] = true;
+                }
+            }
+        }
+    }
+    if (idx < 0 || idx > 255 || !known[idx]) return false;
+    out = colours[idx];
+    return true;
+}
